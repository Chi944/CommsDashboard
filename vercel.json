{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "functions": {
    "api/market/refresh.js": {
      "maxDuration": 120
    },
    "api/smart-money/[route].js": {
      "maxDuration": 120
    }
  },
  "crons": [
    {
      "path": "/api/market/refresh",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/market/refresh",
      "schedule": "0 18 * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/smart-money/:route", "destination": "/api/smart-money/[route]" },
    { "source": "/api/smart-money/:route/", "destination": "/api/smart-money/[route]" },
    { "source": "/api/:path*", "destination": "/api/smart-money/[route]?route=__api_not_found" },
    { "source": "/(.*)", "destination": "/" }
  ]
}
